{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "alibaba"
  ],
  "default_agent": "build",
  "model": "ai-gateway/glm-5.3-flash",
  "plugin": [
    "@dana/ml-ops-opencode-remote-config",
    "@franlol/opencode-md-table-formatter"
  ],
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "maxcompute": {
      "type": "remote",
      "enabled": false,
      "timeout": 600000,
      "url": "https://mlops-dev.dana.id/maxcompute-mcp/mcp"
    },
    "exa": {
      "type": "remote",
      "enabled": false,
      "oauth": false,
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "581598c6-ccda-42e6-b77e-39f980c4054b"
      }
    },
    "dataworks": {
      "type": "remote",
      "enabled": false,
      "timeout": 600000,
      "url": "https://mlops-dev.dana.id/dataworks-mcp/mcp"
    },
    "airflow": {
      "type": "remote",
      "enabled": false,
      "timeout": 600000,
      "url": "https://mlops-dev.dana.id/airflow-mcp/mcp"
    },
    "airflow_mlops": {
      "type": "remote",
      "enabled": false,
      "timeout": 600000,
      "url": "https://mlops-airflow-prod-mcp.dana.id/mcp"
    },
    "notion": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.notion.com/mcp"
    },
    "lini_kawitan": {
      "type": "remote",
      "enabled": false,
      "timeout": 600000,
      "url": "https://mlops-dev.dana.id/lini-kawitan-mcp/mcp"
    },
    "qmd": {
      "type": "remote",
      "enabled": false,
      "timeout": 600000,
      "url": "https://mlops-dev.dana.id/qmd-mcp/mcp"
    },
    "aidea": {
      "type": "remote",
      "enabled": false,
      "timeout": 600000,
      "url": "https://aidea.dana.id/repoagent/v2/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  },
  "provider": {
