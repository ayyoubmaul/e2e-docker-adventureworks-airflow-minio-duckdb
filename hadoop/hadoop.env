# ─────────────────────────────────────────────────────────────────────────────
# Konfigurasi cluster HDFS — image apache/hadoop:3.3.6
#
# Pola penamaan env: PREFIX-SITE.XML_<property>
#   CORE-SITE.XML_fs.defaultFS  →  <property><name>fs.defaultFS</name></property> di core-site.xml
#   HDFS-SITE.XML_dfs.replication → property dfs.replication di hdfs-site.xml
#
# fs.defaultFS memakai port 9000 (sama seperti day43-production) —
# NameNode otomatis bind RPC di host:port dari fs.defaultFS.
# ─────────────────────────────────────────────────────────────────────────────

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:9000
CORE-SITE.XML_hadoop.http.staticuser.user=root

HDFS-SITE.XML_dfs.webhdfs.enabled=true
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.replication=1
